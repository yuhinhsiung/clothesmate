    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35,72 L54,46 L54,46 L73,72 Q73,75 69,75 L39,75 Q35,75 35,72 Z" />

    <!-- 两端挂衣小竖杆 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35,72 Q31,72 31,68 L31,62 Q31,58 35,58 L39,58 L39,62 L35,62 L35,72 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M73,72 Q77,72 77,68 L77,62 Q77,58 73,58 L69,58 L69,62 L73,62 L73,72 Z" />

    <!-- 底边横杆 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,79 L69,79 L69,83 L39,83 Z" />
</vector>
