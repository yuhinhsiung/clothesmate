    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 衣钩：竖线 + 左弯钩尖 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,34 L51,45 L46,45 L46,34 Q46,28 52,28 Q58,28 58,33 L58,38 L53,38 L53,33 Q53,32 52,32 Q51,32 51,34 Z" />

